# Database Configuration (Turso)
TURSO_CONNECTION_URL=your_turso_connection_url_here
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob Storage (for image uploads)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Note: Copy this file to .env and fill in your actual values
# Never commit .env to version control
# For production deployment, set these in Vercel Dashboard → Settings → Environment Variables